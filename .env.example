# Public URL the app is reached at (used in invite links, emails, Telegram messages)
APP_URL=http://localhost:3000
# Timezone for the fixed check schedule (00:00, 06:00, 12:00, 18:00 ...)
TZ=Europe/Ljubljana
# SQLite database file (mounted volume in Docker)
DATABASE_PATH=./data/price-tracker.db

# Email alerts (optional) - any SMTP server (NeoServ mailbox, Gmail app password, Resend SMTP...)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Price Tracker <alerts@example.com>"

# Telegram alerts (optional) - create a bot with @BotFather and paste its token
TELEGRAM_BOT_TOKEN=
